APP_ENV=development
SECRET_KEY=change_me
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ANALYSIS_LOCAL_ONLY=true
# Set ANALYSIS_LOCAL_ONLY=false in production; startup rejects the local bypass.
# Required in production. Generate at least 32 random characters.
ANALYSIS_API_TOKEN=
ANALYSIS_TOKEN_SUBJECT=analysis-service
ANALYSIS_STORE_ENABLED=false
ANALYSIS_DATABASE_PATH=
AUTH_DATABASE_PATH=
EXAMPLE_DATABASE_PATH=
# Required when immutable storage is enabled; minimum 32 random characters.
RECORD_INTEGRITY_KEY=
WORKSPACE_ROOT=
EMAIL_VERIFICATION_ENABLED=true
# Generate at least 32 random characters. Keep this separate from SECRET_KEY.
EMAIL_VERIFICATION_HMAC_KEY=
# Comma-separated allowlist prevents this endpoint becoming an open mail relay.
VERIFICATION_ALLOWED_EMAILS=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
# Prefer a dedicated Hostinger Email app password if your plan supports it;
# otherwise use the mailbox credential. Store it only in ignored backend/.env
# or the deployment secret store. Never commit the credential.
SMTP_PASSWORD=
SMTP_SENDER=
# Optional token-protected /send endpoint using Flask-Mail and Gmail STARTTLS.
# Set EMAIL_USER to a Gmail or Google Workspace sender authorized to use Gmail SMTP.
# EMAIL_PASS is its app password or approved SMTP credential, never the account password.
# Keep this service disabled until DNS authentication and sending limits are checked.
MAIL_SEND_ENABLED=false
MAIL_SEND_API_TOKEN=
MAIL_ALLOWED_RECIPIENTS=
EMAIL_USER=
EMAIL_PASS=
# Keep false until a verified disposable sandbox runtime is configured.
ISOLATION_RUNTIME_AVAILABLE=false
# When true, exact package coordinates are sent to the fixed OSV API endpoint.
# No uploaded source code or manifest body is sent.
OSV_ADVISORY_LOOKUP_ENABLED=false
CODEX_ADVISOR_ENABLED=false
OPENAI_API_KEY=
# Required when the advisor is enabled; choose an approved model explicitly.
OPENAI_MODEL=
CODEX_CONTEXT_MAX_CHARACTERS=6000
