APP_ENV=development
SECRET_KEY=change_me
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ANALYSIS_LOCAL_ONLY=true
# Required in production. Generate at least 32 random characters.
ANALYSIS_API_TOKEN=
ANALYSIS_TOKEN_SUBJECT=analysis-service
ANALYSIS_STORE_ENABLED=false
ANALYSIS_DATABASE_PATH=
# Required when immutable storage is enabled; minimum 32 random characters.
RECORD_INTEGRITY_KEY=
WORKSPACE_ROOT=
EMAIL_VERIFICATION_ENABLED=true
# Generate at least 32 random characters. Keep this separate from SECRET_KEY.
EMAIL_VERIFICATION_HMAC_KEY=
# Comma-separated allowlist prevents this endpoint becoming an open mail relay.
VERIFICATION_ALLOWED_EMAILS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
# For Gmail, use an app password; never commit the account password.
SMTP_PASSWORD=
SMTP_SENDER=
# Keep false until a verified disposable sandbox runtime is configured.
ISOLATION_RUNTIME_AVAILABLE=false
CODEX_ADVISOR_ENABLED=false
OPENAI_API_KEY=
# Required when the advisor is enabled; choose an approved model explicitly.
OPENAI_MODEL=
CODEX_CONTEXT_MAX_CHARACTERS=6000
